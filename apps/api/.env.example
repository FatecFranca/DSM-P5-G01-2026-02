# Desenvolvimento local (padrão): SQLite em arquivo.
DATABASE_URL=sqlite+pysqlite:///./alfabetiza.db
# Produção / Docker Compose: postgresql+psycopg://alfabetiza:SENHA@db:5432/alfabetiza
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ENVIRONMENT=development
# Login com Google via Firebase Auth: ID do projeto Firebase (audiência dos ID tokens).
FIREBASE_PROJECT_ID=
# Ranking no servidor (docs/adr/0004). Desligado = só regras. Shadow = calcula e registra, mas serve regras.
RANKING_MODEL_ENABLED=false
RANKING_MODEL_PATH=
RANKING_SHADOW_MODE=true
RANKING_EPSILON=0.05
